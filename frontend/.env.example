# photoSwitch 前端配置示例
#
# 使用方式：
#   cp frontend/.env.example frontend/.env
#   （本地开发通常无需修改，保持默认即可连上 http://localhost:7001 的后端）
#
# 说明：
#   - 前端所有请求都走相对路径 /api，由 Vite 开发服务器代理转发到后端，
#     因此浏览器端不存在跨域问题，也不需要把后端地址写死在代码里
#   - 只有 VITE_ 前缀的变量会被 Vite 暴露给客户端代码
#   - 修改后需要重启 `make frontend` / `make dev` 才会生效
#   - .env 已被 .gitignore 忽略，不会提交

# 开发服务器 /api 代理目标（默认 http://localhost:7001）
VITE_API_PROXY_TARGET=http://localhost:7001

# 后端 API 基础地址：
#   - 未设置 VITE_API_PROXY_TARGET 时，作为代理目标的兜底值
#   - 两者都不设置时使用默认值 http://localhost:7001
VITE_API_BASE_URL=http://localhost:7001

# 常见场景示例：
#   后端跑在 Docker 里、前端跑在宿主机：
#     VITE_API_PROXY_TARGET=http://localhost:7001
#   前后端都在 Docker（docker-compose.dev.yml）：
#     VITE_API_PROXY_TARGET=http://host.docker.internal:7001
#   后端部署在局域网另一台机器（例如 Mac mini 192.168.1.10）：
#     VITE_API_PROXY_TARGET=http://192.168.1.10:7001
